    "react-icons": "^5.5.0",
    "react-onesignal": "^3.4.0",
    "react-router-dom": "^6.30.2",
    "react-scripts": "5.0.1",
    "recharts": "^2.5.0",
    "sweetalert2": "^11.26.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
